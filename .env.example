# ==========================================
# Marketing & Product Intelligence Hub (.env)
# ==========================================

# Groq LLM API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Models
GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Hindsight Configuration
# For local instance: http://127.0.0.1:8888
# For cloud instance: https://api.hindsight.vectorize.io
HINDSIGHT_API_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=

# Local Hindsight Engine Settings
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-20b
HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=on_demand

# Application Server Port
PORT=8000
HOST=127.0.0.1
